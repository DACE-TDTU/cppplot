-  figure(900, 600);
-
-  plot(omega, S_mag, "-",
-       opts({{"color", "#1f77b4"},
-             {"linewidth", "2"},
-             {"label", "S (Sensitivity)"}}));
-  plot(omega, T_mag, "-",

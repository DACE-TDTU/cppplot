+    
+    std::vector<double> mag, phase_raw;
+    for (double w : omega) {
+        mag.push_back(H.mag_dB(w));
+        phase_raw.push_back(H.phase_deg(w));
+    }
+    
+    // Unwrap phase
+    std::vector<double> phase = phase_raw;
+    for (size_t i = 1; i < phase.size(); ++i) {
+        while (phase[i] - phase[i-1] > 180) phase[i] -= 360;
+        while (phase[i] - phase[i-1] < -180) phase[i] += 360;
+    }
+    
+    figure(800, 600);
+    layout(2, 1);
+    
+    subplot(2, 1, 1);

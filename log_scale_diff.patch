-        , g_(static_cast<uint8_t>(clamp_value(g, 0, 255)))
-        , b_(static_cast<uint8_t>(clamp_value(b, 0, 255)))
-        , a_(static_cast<uint8_t>(clamp_value(a, 0, 255))) {}

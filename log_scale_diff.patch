-/**
- * @brief Constructs a block Hankel matrix from 1D data.
- *
- * Hankel matrix structure with `i` block rows:
- * [ y(0) y(1) ... y(j-1) ]
- * [ y(1) y(2) ... y(j)   ]
- * [ ...                  ]
- * [ y(i) ...      y(i+j-1)]
- *
- * @param data 1D time-series data
- * @param i    Number of block rows
- * @param j    Number of columns. If 0, uses max possible: length(data) - i + 1
- * @return block Hankel matrix (i × j)
- */
-inline Matrix build_hankel(const std::vector<double> &data, int i, int j = 0) {
-  if (j == 0)
-    j = static_cast<int>(data.size()) - i + 1;
-  if (j <= 0 || i + j - 1 > static_cast<int>(data.size())) {
-    throw std::runtime_error(
-        "build_hankel: invalid block size / not enough data");
-  }
-
-  Matrix H(i, j);
-  for (int r = 0; r < i; ++r) {
-    for (int c = 0; c < j; ++c) {
-      H(r, c) = data[r + c];
-    }
-  }
-  return H;
-}

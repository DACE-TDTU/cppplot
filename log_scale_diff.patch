-    // Build block Hankel matrices (we flatten multi-dim into tall blocks)
-    Matrix Hu = build_hankel_multi(U_data, m_, L, cols);
-    Matrix Hy = build_hankel_multi(Y_data, p_, L, cols);
-
-    // Partition into Past (T_ini) and Future (horizon)

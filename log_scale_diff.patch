-    // Input-independence test
-    result.residuals_uncorr_with_input = true;
-    for (int tau = 0; tau <= max_lag; ++tau) {
-        if (std::abs(result.crosscorr[tau]) > bound) {
-            result.residuals_uncorr_with_input = false;

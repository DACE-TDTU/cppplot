-        std::cout << "    λ₁ = " << eq.eig1_re;
-        if (std::abs(eq.eig1_im) > 1e-10)
-            std::cout << " ± " << std::abs(eq.eig1_im) << "j";
-        std::cout << "\n";
-        std::cout << "    λ₂ = " << eq.eig2_re;
-        if (std::abs(eq.eig2_im) > 1e-10)
-            std::cout << " ± " << std::abs(eq.eig2_im) << "j";

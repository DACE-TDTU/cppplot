-    Axes& add_subplot(int nrows, int ncols, int index) {
-        // If no GridSpec set, create one
-        if (!useGridSpec_ || gridSpec_.nrows != nrows || gridSpec_.ncols != ncols) {
-            gridSpec_ = GridSpec(nrows, ncols);

-/**
- * @brief H2 state-feedback result
- */
-struct H2StateFeedbackResult {
-  Matrix K;       ///< State-feedback gain
-  Matrix P;       ///< ARE solution
-  double h2_norm; ///< Achieved H2 norm
-  bool success;
-
-  H2StateFeedbackResult() : h2_norm(0), success(false) {}
-};

-
-// Define M_PI for Windows compatibility
-#ifndef M_PI
-#define M_PI 3.14159265358979323846
-#endif
-
-#include "transfer_function.hpp"
-#include "analysis.hpp"
-#include "../pyplot.hpp"
-#include <vector>
-#include <cmath>
-#include <sstream>

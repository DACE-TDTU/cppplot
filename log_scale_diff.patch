- */
-inline std::string escapeXML(const std::string& str) {
-    std::string result;
-    result.reserve(str.size());
-    
-    for (char c : str) {
-        switch (c) {
-            case '&': result += "&amp;"; break;
-            case '<': result += "&lt;"; break;
-            case '>': result += "&gt;"; break;
-            case '"': result += "&quot;"; break;
-            case '\'': result += "&apos;"; break;
-            default: result += c;
-        }
-    }
-    
-    return result;
-}

- * - Peak μ indicator
- * 
- * @param result μ frequency sweep result
- * @param filename Output filename (without extension)
- */
-inline void plotMuFrequencyResponse(
-    const MuFrequencyResult& result,
-    const std::string& filename = "mu_analysis"
-) {
